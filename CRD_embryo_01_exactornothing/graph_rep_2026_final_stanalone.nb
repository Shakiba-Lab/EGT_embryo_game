1}, tar = {1, 2}
cond = {0, 5 - 6}, cl = {0, 0.25, 0.5, 1}, probrang = {0, 0.5, 0.8, 0.9, \
0.95, 1}, tar = {1, 2, 3}
(*Parameters explored 1 Round, {-1,0,1,2}*)
cond = {0, 0}, cl = {0, 0.25, 0.5, 1}, probrang = {0, 0.5, 0.8, 0.9, 0.95, \
1}, tar = {1, 2}\
\>", "Text",
