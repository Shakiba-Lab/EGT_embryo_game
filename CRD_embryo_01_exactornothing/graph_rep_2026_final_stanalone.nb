             RowBox[{"prob", "[", 
              RowBox[{"[", 
               RowBox[{"probL", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", "2"}], 
            "]"}], "]"}]}], 
         RowBox[{"(*", 
