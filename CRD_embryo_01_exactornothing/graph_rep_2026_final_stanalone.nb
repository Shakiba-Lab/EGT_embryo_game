       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"ft_", ":", "16"}]}], "]"}], ":=", 
  RowBox[{"PieChart", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Null", ",", "Null"}], "}"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"i", "==", 
                  RowBox[{"probL", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}], "&&", 
                 RowBox[{"#1", ">", "0.002"}]}], ")"}], "||", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"i", "==", 
                  RowBox[{"probL", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
                 RowBox[{"#1", ">", "0.802"}]}], ")"}], "||", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"i", "==", "19"}], "&&", 
                 RowBox[{"#1", ">", "0.6"}]}], ")"}]}], ")"}], ",", 
             RowBox[{"Labeled", "[", 
              RowBox[{"#1", ",", "#2", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "==", 
                  RowBox[{"probL", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], 
                 ",", "\"\<RadialCenter\>\"", 
                 RowBox[{"(*", "\"\<RadialInside\>\"", "*)"}], 
                 ",", "\"\<RadialCallout\>\""}], "]"}]}], "]"}], ",", "#1"}], 
            "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Normalize", "[", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"data", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/.", 
                RowBox[{
                 RowBox[{"_", "?", "Negative"}], "->", "0"}]}], ")"}], "]"}], 
             ")"}], ",", "strata"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "probL"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"ChartStyle", "->", 
     RowBox[{"If", "[", 
