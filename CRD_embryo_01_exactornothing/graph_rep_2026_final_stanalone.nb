    RowBox[{"ChartLayout", "->", 
     RowBox[{"(*", "\"\<Percentile\>\"", "*)"}], "\"\<Stacked\>\""}], ",", 
    RowBox[{"ChartLabels", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"probrang", ",", "None"}], "}"}]}], ",", 
