               RowBox[{"cola", ",", "0.2"}], "]"}]}], "}"}], ",", "#"}], 
           "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{"1", "/", 
            RowBox[{"Length", "[", "strata", "]"}]}]}], "]"}]}], ")"}], ",", 
       "cola"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"ChartLabels", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
