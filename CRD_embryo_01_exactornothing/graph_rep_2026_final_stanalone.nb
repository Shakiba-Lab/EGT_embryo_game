1}, tar = {1, 2, 3}
cond = {1, 0, -1}, cl = {0}, probrang = {0, 0.5, 0.8, 0.9, 0.95, 1}, tar = \
{1, 2} -- > keep killers in the first round
(*Parameters explored 1 Round, {-1,0,1}*)
