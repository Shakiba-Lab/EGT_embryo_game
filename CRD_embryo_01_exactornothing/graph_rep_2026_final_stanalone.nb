       RowBox[{"{", 
        RowBox[{"40", ",", "30"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"ft_", ":", "16"}], ",", 
    RowBox[{"lg_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"PieChart", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Null", ",", "Null"}], "}"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"i", "==", 
                    RowBox[{"probL", "[", 
                    RowBox[{"[", 
                    RowBox[{"Length", "[", "probL", "]"}], "]"}], "]"}]}], "&&", 
                   RowBox[{"#1", ">", "0.02"}]}], ")"}], ")"}], "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"i", "==", "19"}], "&&", 
                  RowBox[{"#1", ">", "0.6"}]}], ")"}], "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"i", "==", 
                   RowBox[{"probL", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
                  RowBox[{"#1", ">", "0.9002"}]}], ")"}]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"lg", "==", "0"}], ")"}]}], ",", 
             RowBox[{"Labeled", "[", 
              RowBox[{"#1", ",", "#2", ",", 
               RowBox[{"If", "[", 
