          RowBox[{"0", ",", "0.9"}], "}"}]}], "]"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"\"\<p=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"prob", "[", 
                 RowBox[{"[", "#1", "]"}], "]"}], "+", "0."}], ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"1.65", "+", "#2"}]}], "}"}]}], "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"probL", ",", 
          RowBox[{"Accumulate", "[", 
           RowBox[{
            RowBox[{"2.25", "&"}], "/@", "probL"}], "]"}]}], "}"}]}], "]"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"\"\<p=\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"prob", "[", 
              RowBox[{"[", 
               RowBox[{"probL", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}], ",", "3"}], 
            "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "5.65"}], "}"}]}], "]"}], "*)"}], "}"}]}], ",", 
    RowBox[{"ImagePadding", "->", "ip"}], ",", 
    RowBox[{"SectorSpacing", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1.3"}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Black", ",", "\"\<Helvetica\>\"", ",", "ft"}], "}"}]}], ",", 
    RowBox[{"ChartBaseStyle", "\[Rule]", 
     RowBox[{"EdgeForm", "[", "]"}]}], ",", 
