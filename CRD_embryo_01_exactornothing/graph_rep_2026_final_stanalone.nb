    "\[IndentingNewLine]", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"\"\<p=\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"prob", "[", 
              RowBox[{"[", 
               RowBox[{"probL", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", "2"}], 
            "]"}], "]"}]}], 
