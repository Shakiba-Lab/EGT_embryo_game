          RowBox[{
           RowBox[{"-", "6"}], ";;", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], "*)"}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"lg", "==", "1"}], ",", 
      RowBox[{"ChartLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"SwatchLegend", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", "cola", "]"}], ",", 
           RowBox[{"Reverse", "[", "strata", "]"}], ",", 
           RowBox[{"LegendLayout", "\[Rule]", "ta"}]}], "]"}], ",", "Right"}],
         "]"}]}], ",", 
      RowBox[{"ChartLegends", "\[Rule]", "None"}]}], "]"}], ",", 
