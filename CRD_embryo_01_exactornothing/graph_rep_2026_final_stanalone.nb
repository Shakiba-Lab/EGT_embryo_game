Cell[BoxData[
 RowBox[{
  RowBox[{"pieFun4", "[", 
   RowBox[{"data_", ",", "strata_", ",", "prob_", ",", "cola_", ",", 
    RowBox[{"probL_", ":", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5", ",", "6"}], "}"}]}], ",", 
    RowBox[{"opt_", ":", "0"}], ",", 
    RowBox[{"res_", ":", "400"}], ",", 
    RowBox[{"ip_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
